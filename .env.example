# Copy this file to .env.local and fill in the values. Never commit .env.local.
# All of these are server-only: none may start with NEXT_PUBLIC_.

# Gemini API key from Google AI Studio (free tier for this demo).
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
# Used only when the primary model hits a rate limit, a server error or a timeout.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Supabase project URL (the project's Connect dialog) and a secret key, sb_secret_... (Settings > API Keys).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random value of at least 32 bytes. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROFILE_SIGNING_SECRET=
