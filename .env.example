# Copy this file to .env.local and fill in the values. Never commit .env.local.
# All of these are server-only: none may start with NEXT_PUBLIC_.

# Gemini API key from Google AI Studio (free tier for this demo).
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
# Review before December 1, 2026, when this model starts routing to the primary model.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Supabase project URL and secret key (Project Settings > API Keys).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random value of at least 32 bytes. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROFILE_SIGNING_SECRET=
